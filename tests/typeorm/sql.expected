  qb: SELECT "b"."NM_BENEFICIARIO" AS "b_NM_BENEFICIARIO", "b"."CD_BENEFICIARIO" AS "b_CD_BENEFICIARIO" FROM "TB_BENEFICIARIO" "b" INNER JOIN "VW_RESUMO" "r" ON "r"."CD_GRUPO" = "b"."CD_BENEFICIARIO" WHERE ("b"."FL_ATIVO" = $1) AND ("b"."CD_BENEFICIARIO" IN ($2, $3)) AND ("b"."NM_BENEFICIARIO" LIKE 'x:y') ORDER BY "b"."NM_BENEFICIARIO" DESC LIMIT 5 OFFSET 5
