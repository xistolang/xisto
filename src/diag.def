/* The catalog of diagnostics: one entry per message, a stable code, its category (src/xisto.h DiagCat)
   and the message format. Generated once from the xs_error calls (09/11/2026); new errors take the next
   free code of their category by hand. xisto check groups by category; the codes are documentation. */
DIAG(XS1001, DC_SYNTAX, "'!=' is not supported") /* retired 10/11/2026: != is !== when no coercion could happen (XS8148) */
DIAG(XS1002, DC_SYNTAX, "'==' is not supported") /* retired 10/11/2026: == is === when no coercion could happen (XS8148) */
DIAG(XS1003, DC_SYNTAX, "'?%c' is not supported") /* retired 10/11/2026: ?? and ?. exist over T | null */
DIAG(XS1004, DC_SYNTAX, "a BigInt literal has no leading zero")
DIAG(XS1005, DC_SYNTAX, "a BigInt literal is an integer: no '.' or exponent")
DIAG(XS1006, DC_SYNTAX, "a unary operator before ** needs parentheses")
DIAG(XS1007, DC_SYNTAX, "empty ${} in template literal")
DIAG(XS1008, DC_SYNTAX, "expected %s but found %s")
DIAG(XS1009, DC_SYNTAX, "expected ';' but found %s")
DIAG(XS1010, DC_SYNTAX, "expected 'catch' or 'finally' after the try block")
DIAG(XS1011, DC_SYNTAX, "expected 'from'")
DIAG(XS1012, DC_SYNTAX, "expected 'function' or 'class' after 'declare'")
DIAG(XS1013, DC_SYNTAX, "expected 'null' after '|'")
DIAG(XS1014, DC_SYNTAX, "expected 'of' after the destructuring of a for loop")
DIAG(XS1015, DC_SYNTAX, "expected '{'")
DIAG(XS1016, DC_SYNTAX, "expected '{' after import")
DIAG(XS1017, DC_SYNTAX, "expected a declaration after 'export'")
DIAG(XS1018, DC_SYNTAX, "expected a key in the object literal")
DIAG(XS1019, DC_SYNTAX, "expected a type but found %s")
DIAG(XS1020, DC_SYNTAX, "expected an arrow function after 'async'")
DIAG(XS1021, DC_SYNTAX, "expected an expression but found %s")
DIAG(XS1022, DC_SYNTAX, "import after declarations")
DIAG(XS1023, DC_SYNTAX, "malformed %s literal")
DIAG(XS1024, DC_SYNTAX, "malformed escape sequence in string literal")
DIAG(XS1025, DC_SYNTAX, "malformed escape sequence in template literal")
DIAG(XS1026, DC_SYNTAX, "malformed number literal")
DIAG(XS1027, DC_SYNTAX, "two default cases")
DIAG(XS1028, DC_SYNTAX, "unexpected %s inside ${}")
DIAG(XS1029, DC_SYNTAX, "unexpected character '%c'")
DIAG(XS1030, DC_SYNTAX, "unexpected end of file inside '%s'")
DIAG(XS1031, DC_SYNTAX, "unexpected end of file inside a block")
DIAG(XS1032, DC_SYNTAX, "unexpected end of file inside switch")
DIAG(XS1033, DC_SYNTAX, "unterminated block comment")
DIAG(XS1034, DC_SYNTAX, "unterminated regular expression")
DIAG(XS1035, DC_SYNTAX, "unterminated string literal")
DIAG(XS1036, DC_SYNTAX, "unterminated template literal")
DIAG(XS1037, DC_SYNTAX, "write %s %s(...) { ... }")
DIAG(XS1038, DC_UNSUPPORTED, "renaming in a re-export ('%s as %s') is not supported")
DIAG(XS1039, DC_UNSUPPORTED, "'export * as %s' (a namespace re-export) is not supported")
DIAG(XS1040, DC_SYNTAX, "too many '?.' in one chain")
